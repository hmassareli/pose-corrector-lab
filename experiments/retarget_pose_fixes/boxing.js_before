    const focus = new THREE.Vector3(fighters[loser].x, 0, fighters[loser].z).addScaledVector(away, ko.victim === null ? -0.6 : 0.35);
    const angle = Math.atan2(away.x, away.z) + Math.PI / 2 + (performance.now() - ko.start) * 0.00012;
