const actors = [null, null];
const presentation = [new PoseRenderBuffer(), new PoseRenderBuffer()];
const presentedSource = [null, null];
const handPrevious = [[null, null], [null, null]];
const bruises = [[], []];
function notify(text, seconds = 1.1) {
