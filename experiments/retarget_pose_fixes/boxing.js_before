          b.headHits = b.headHits.filter((t) => now - t < 3000);
          b.headHits.push(now);
          b.stun = Math.max(b.stun, 0.45 + 0.4 * power);
          if (chin) a.stats.chin++;
          if ((chin || b.headHits.length >= 3) && b.dizzy <= 0 && b.dizzyImmune <= 0 && b.hp > 0) {
