  applyBlockHold(i);
  const localFirst = active && first && i === self;
  a.clip.active.value = localFirst ? 1 : 0;
  const headPosition = a.rig.bones.get("head").bone.getWorldPosition(new THREE.Vector3());
  a.clip.head.value.copy(headPosition);
